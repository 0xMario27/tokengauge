{
  "name": "tokengauge",
  "version": "0.1.0",
  "private": true,
  "description": "Floating usage dashboard for AI services (plugin-based providers)",
  "license": "MIT",
  "author": "0xMario <liutingwei3996@gmail.com>",
  "repository": "github:0xMario27/tokengauge",
  "author": "ghostliu",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.main.json && tsc -p tsconfig.renderer.json",
    "selftest": "npm run build && node dist/selftest.js",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --mac",
    "dist:x64": "npm run build && electron-builder --mac --x64"
  },
  "build": {
    "appId": "com.ghostliu.tokengauge",
    "productName": "TokenGauge",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "src/renderer/index.html",
      "scripts/tray-icon.png",
      "providers/**/*"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "electron": "^33.4.11",
    "electron-builder": "^26.15.3",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
